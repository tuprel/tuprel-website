{
  "name": "@tuprel/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "24.x" },
  "scripts": {
    "docs:sync": "node scripts/sync-docs.mjs",
    "dev": "pnpm docs:sync && next dev --hostname 127.0.0.1",
    "build": "pnpm docs:sync && next build",
    "lint": "eslint .",
    "typecheck": "pnpm docs:sync && next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "preview": "node scripts/serve.mjs",
    "audit": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0"
  }
}
